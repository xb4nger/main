local noclip = false
local savedCanCollide = {}

local function applyNoclipToChar(char)
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if savedCanCollide[part] == nil then savedCanCollide[part] = part.CanCollide end
            part.CanCollide = false
        end
    end
end

local function restoreCollisions()
    for part, orig in pairs(savedCanCollide) do
        if part and part.Parent then
            part.CanCollide = orig
        end
    end
    savedCanCollide = {}
end

bp:AddToggle("Noclip", {
    Text = "Noclip",
    Default = false,
}):OnChanged(function(state)
    noclip = state
    if noclip then
        applyNoclipToChar(LocalPlayer.Character)
    else
        restoreCollisions()
    end
end)

