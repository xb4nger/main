                table.insert(values, v.Name)
            end
        end

        dropdown:SetValues(values)

        dropdown:OnChanged(function(v)
            selectedName = v
        end)

        return function()
            if not selectedName then return end
            local btn = Content:FindFirstChild(selectedName)
            if not btn then return end
            replicatesignal(btn.MouseButton1Down, 0, 0)
            task.wait(0.15)
            replicatesignal(Purchase.MouseButton1Down, 0, 0)
        end
    end

    local purchaseFunc = rebuild()

    LP.CharacterAdded:Connect(function()
        task.wait(1)
        purchaseFunc = rebuild()
    end)

    return function()
        purchaseFunc()
    end
end


