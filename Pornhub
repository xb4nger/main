	getgenv().s = ""
	getgenv().c = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
	for i = 1, len or 12 do
		getgenv().r = math.random(1, #getgenv().c)
		getgenv().s = getgenv().s .. getgenv().c:sub(getgenv().r, getgenv().r)
	end
	return getgenv().s
end

getgenv().Tween = function(o, t, p)
	getgenv().tw = getgenv().TweenService:Create(
		o,
		TweenInfo.new(t or 1, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		p
	)
	getgenv().tw:Play()
	return getgenv().tw
end

