local function setupCharacter(char)
    local function applyWhenExists(partName)
        local target = getTarget(char)
        if target then
            applyHitbox(char)
        else
            char.ChildAdded:Connect(function(child)
                if child.Name:lower() == partName:lower() then
                    applyHitbox(char)
                end
            end)
        end
    end

    if getgenv().HitboxPart == "Head" then
        applyWhenExists("Head")
    else
        applyWhenExists("HumanoidRootPart")
        applyWhenExists("UpperTorso")
        applyWhenExists("LowerTorso")
        applyWhenExists("Torso")
    end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.Died:Connect(function()
            restoreHitbox(char)
        end)
    end
end

local function setupPlayer(plr)
    if plr.Character then
        setupCharacter(plr.Character)
    end
    plr.CharacterAdded:Connect(function(char)
        task.wait(0.1)
        setupCharacter(char)
    end)
    plr.AncestryChanged:Connect(function(_, parent)
        if not parent and plr.Character then
            restoreHitbox(plr.Character)
        end
    end)
end

