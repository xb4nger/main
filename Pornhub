getgenv().getClosestSafeZone = function(hrp)
    local safeZones = workspace:FindFirstChild("SafeZones")
    if not safeZones then
        return nil
    end

    local closest, dist = nil, math.huge

    for _, obj in ipairs(safeZones:GetDescendants()) do
        if obj:IsA("BasePart") then
            local d = (obj.Position - hrp.Position).Magnitude
            if d < dist then
                dist = d
                closest = obj
            end
        end
    end

    return closest
end

getgenv().ensureHook = function()
    if getgenv().old_namecall then
        return
    end

    setreadonly(getgenv().mt, false)
    getgenv().old_namecall = getgenv().mt.__namecall

    getgenv().mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if self == getgenv().rf and method == "FireServer" then
            return
        end
        return getgenv().old_namecall(self, ...)
    end)

    setreadonly(getgenv().mt, true)
end

getgenv().removeHook = function()
    if not getgenv().old_namecall then
        return
    end

    setreadonly(getgenv().mt, false)
    getgenv().mt.__namecall = getgenv().old_namecall
    setreadonly(getgenv().mt, true)
    getgenv().old_namecall = nil
end

