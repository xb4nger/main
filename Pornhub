local function getTarget(char)
    if getgenv().HitboxPart == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChild("head")
    else
        return char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("LowerTorso")
            or char:FindFirstChild("Torso")
    end
end

local function applyHitbox(char)
    if char == LP.Character then return end
    local target = getTarget(char)
    if not target then return end

    getgenv().OriginalSizes[char] = getgenv().OriginalSizes[char] or {}
    if not getgenv().OriginalSizes[char][target] then
        getgenv().OriginalSizes[char][target] = target.Size
    end

    target.Size = Vector3.new(getgenv().HitboxSize, getgenv().HitboxSize, getgenv().HitboxSize)
    target.Massless = true
    target.CanCollide = false
end

local function restoreHitbox(char)
    local parts = getgenv().OriginalSizes[char]
    if not parts then return end
    for part, orig in pairs(parts) do
        if part and part.Parent then
            part.Size = orig
        end
    end
    getgenv().OriginalSizes[char] = nil
end

local function updateAll()
    if getgenv().HitboxEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                applyHitbox(plr.Character)
            end
        end
    end
end

