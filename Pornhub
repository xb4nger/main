local cam = workspace.CurrentCamera
local uis = game:GetService("UserInputService")
local rs = game:GetService("RunService")

local kb = {W=false,A=false,S=false,D=false,Space=false,Shift=false}
local pos = Vector3.new()
local yaw = 0
local pitch = 0

uis.InputBegan:Connect(function(i,g)
    if g then return end
    if i.KeyCode == Enum.KeyCode.W then kb.W = true end
    if i.KeyCode == Enum.KeyCode.A then kb.A = true end
    if i.KeyCode == Enum.KeyCode.S then kb.S = true end
    if i.KeyCode == Enum.KeyCode.D then kb.D = true end
    if i.KeyCode == Enum.KeyCode.Space then kb.Space = true end
    if i.KeyCode == Enum.KeyCode.LeftShift then kb.Shift = true end
end)

uis.InputEnded:Connect(function(i)
    if i.KeyCode == Enum.KeyCode.W then kb.W = false end
    if i.KeyCode == Enum.KeyCode.A then kb.A = false end
    if i.KeyCode == Enum.KeyCode.S then kb.S = false end
    if i.KeyCode == Enum.KeyCode.D then kb.D = false end
    if i.KeyCode == Enum.KeyCode.Space then kb.Space = false end
    if i.KeyCode == Enum.KeyCode.LeftShift then kb.Shift = false end
end)

rs.RenderStepped:Connect(function(dt)
    if not freecam_enabled then return end

    local speed = kb.Shift and 60 or 30
    local move = Vector3.new()

    if kb.W then move = move + cam.CFrame.LookVector end
    if kb.S then move = move - cam.CFrame.LookVector end
    if kb.A then move = move - cam.CFrame.RightVector end
    if kb.D then move = move + cam.CFrame.RightVector end
    if kb.Space then move = move + Vector3.new(0,1,0) end

    pos = pos + move * speed * dt

    local d = uis:GetMouseDelta()
    yaw = yaw - d.X * 0.003
    pitch = pitch - d.Y * 0.003
    pitch = math.clamp(pitch, -1.2, 1.2)

    cam.CFrame = CFrame.new(pos)
        * CFrame.Angles(0, yaw, 0)
        * CFrame.Angles(pitch, 0, 0)
end)

rs:BindToRenderStep("FCINIT", Enum.RenderPriority.First.Value, function()
    if freecam_enabled then
        local cf = cam.CFrame
        pos = cf.Position
        local x,y,z = cf:ToOrientation()
        pitch = x
        yaw = y
        rs:UnbindFromRenderStep("FCINIT")
    end
end)






local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Mouse = LocalPlayer:GetMouse()

local RayParams = RaycastParams.new()

sa_enabled = false
sa_instant_bullet = false
sa_target_part = "Head"
sa_max_dist = 300
sa_fov_enabled = false
sa_fov_color = Color3.fromRGB(255,255,255)
sa_fov_size = 300
sa_wallcheck = false

local fovCircle = Drawing.new("Circle")
fovCircle.Visible = false
fovCircle.Thickness = 1
fovCircle.Filled = false

local function WallCheck(a,b)
    RayParams.FilterType = Enum.RaycastFilterType.Blacklist
    RayParams.FilterDescendantsInstances = {LocalPlayer.Character}
    local r = workspace:Raycast(a,b-a,RayParams)
    return not r
end

local function GetClosest()
    local best=nil
    local bestDist=math.huge
    local mousePos=UserInputService:GetMouseLocation()
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LocalPlayer and plr.Character then
            local part=plr.Character:FindFirstChild(sa_target_part)
            if part then
                local dist3=(part.Position-Camera.CFrame.Position).Magnitude
                if dist3<=sa_max_dist then
                    local sp,on=Camera:WorldToViewportPoint(part.Position)
                    if on then
                        local mag=(Vector2.new(sp.X,sp.Y)-mousePos).Magnitude
                        if (not sa_fov_enabled) or (mag<=sa_fov_size) then
                            if sa_wallcheck then
                                if WallCheck(Camera.CFrame.Position,part.Position) then
                                    if mag<bestDist then best=plr.Character bestDist=mag end
                                end
                            else
                                if mag<bestDist then best=plr.Character bestDist=mag end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local mt=getrawmetatable(Mouse)
setreadonly(mt,false)
local oldIndex=mt.__index

mt.__index=function(t,k)
    if (sa_enabled or sa_instant_bullet) and (k=="Hit" or k=="Target") then
        local char=GetClosest()
        if char then
            local part=char:FindFirstChild(sa_target_part)
            if part then
                if sa_instant_bullet then
                    return CFrame.new(part.Position)
                end
                local velocity = part.Velocity or Vector3.new(0,0,0)
                return CFrame.new(part.Position + velocity*0.033)
            end
        end
    end
    return oldIndex(t,k)
end

setreadonly(mt,true)

