getgenv().applyGodMode = function()
    if getgenv().applying then
        return
    end

    getgenv().applying = true

    local success, err = pcall(function()
        local char, hrp = getgenv().getChar()
        if not char or not hrp then
            return
        end

        local sinceLast = tick() - (getgenv().lastGodModeApply or 0)
        if sinceLast < 5 then
            task.wait(5 - sinceLast)
        end

        local savedPos = hrp.CFrame
        local gui, blur, frame, label = getgenv().createOverlay()

        getgenv().fadeIn(frame, label, blur, 0.35)
        task.wait(0.4)

        local closestPart = getgenv().getClosestSafeZone(hrp)
        if closestPart then
            hrp.CFrame = closestPart.CFrame + Vector3.new(0, 3, 0)
        end

        local playerSettings = getgenv().lp:FindFirstChild("Settings")
        local settings = playerSettings and playerSettings:FindFirstChild("Settings")

        local gotGodMode = false

        if settings then
            local start = tick()
            repeat
                task.wait(0.1)
                if settings:GetAttribute("GodMode") then
                    gotGodMode = true
                    break
                end
            until tick() - start > 8
        end

        getgenv().ensureHook()

        task.wait(0.3)

        if hrp.Parent and getgenv().lp.Character == char then
            hrp.CFrame = savedPos
        end

        if gotGodMode then
            getgenv().lastGodModeApply = tick()
        end

        getgenv().fadeOut(frame, label, blur, 0.35)
        task.wait(0.4)

        if gui then
            gui:Destroy()
        end

        if blur then
            blur:Destroy()
        end
    end)

    getgenv().applying = false

    if not success then
        getgenv().cleanupOverlay()
        warn("nigga dm b4 with ss", err)
    end
end

