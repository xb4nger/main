-- Helpers
-- ═══════════════════════════════════════════
local function Create(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k == "Parent" then
            obj.Parent = v
        else
            obj[k] = v
        end
    end
    return obj
end

local function AddDoubleStroke(parent)
    Create("UIStroke", {
        Parent = parent,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        LineJoinMode = Enum.LineJoinMode.Miter,
        Color = Theme.Outline,
    })
    Create("UIStroke", {
        Parent = parent,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        LineJoinMode = Enum.LineJoinMode.Miter,
        Color = Theme.Border,
        BorderOffset = UDim.new(0, 1),
    })
end

local function AddAccentLine(parent)
    return Create("Frame", {
        Parent = parent,
        Size = UDim2.new(1, 0, 0, 1),
        BorderSizePixel = 0,
        BackgroundColor3 = Theme.Accent,
        ZIndex = 3,
    })
end

local function AddElementGradient(parent)
    return Create("UIGradient", {
        Parent = parent,
        Rotation = -90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(172, 172, 172)),
        }),
    })
end

local function Tween(obj, props, time)
    local t = TweenService:Create(obj, TweenInfo.new(time or AnimationTime, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function MakeDraggable(gui)
    local dragging, dragStart, startPos
    gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if conn then conn:Disconnect() end
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

local function FadeOutAndDestroy(root, callback)
    local info = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    local last
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("Frame") or d:IsA("TextButton") then
            last = TweenService:Create(d, info, { BackgroundTransparency = 1 })
            last:Play()
        elseif d:IsA("TextLabel") then
            last = TweenService:Create(d, info, { TextTransparency = 1, BackgroundTransparency = 1 })
            last:Play()
        elseif d:IsA("ImageLabel") then
            last = TweenService:Create(d, info, { ImageTransparency = 1, BackgroundTransparency = 1 })
            last:Play()
        elseif d:IsA("UIStroke") then
            last = TweenService:Create(d, info, { Transparency = 1 })
            last:Play()
        end
    end
    if root:IsA("Frame") or root:IsA("TextButton") then
        last = TweenService:Create(root, info, { BackgroundTransparency = 1 })
        last:Play()
    end
    task.delay(0.45, function()
        if root and root.Parent then root:Destroy() end
        if callback then callback() end
    end)
end

