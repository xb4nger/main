-- Pixel font (same as library)
-- ═══════════════════════════════════════════
local PixelFont
do
    local ok, font = pcall(function()
        local dir = "AlwaysWinning"
        if not isfolder(dir) then makefolder(dir) end
        if not isfolder(dir .. "/Assets") then makefolder(dir .. "/Assets") end

        local fontPath = dir .. "/Assets/SmallestPixel7.font"
        local ttfId = "SmallestPixel7"

        if not isfile(ttfId) then
            writefile(ttfId, game:HttpGet("https://github.com/sametexe001/luas/raw/refs/heads/main/smallest_pixel-7.ttf"))
        end

        local data = {
            name = "SmallestPixel7",
            faces = {{
                name = "SmallestPixel7",
                weight = 400,
                style = "Regular",
                assetId = getcustomasset(ttfId)
            }}
        }
        writefile(fontPath, HttpService:JSONEncode(data))
        return Font.new(getcustomasset(fontPath))
    end)

    if ok and font then
        PixelFont = font
    else
        PixelFont = Font.new("rbxasset://fonts/families/LegacyArial.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
    end
end

