local Melatonin = {}
local MainUI = BuildMainWindow()
local LoadUI = BuildLoadingWindow()

local ActiveRow = nil
local FrameUrls = {}
local FrameCallbacks = {}

local function SetRowSelected(row, refs, selected)
    if selected then
        Tween(row, { BackgroundColor3 = Theme.HoveredElement })
        Tween(refs.Name, { TextColor3 = Theme.Accent })
        Tween(refs.Status, { TextColor3 = Theme.Text })
        Tween(refs.BadgeText, { TextColor3 = Theme.Text })
        Tween(refs.Icon, { ImageTransparency = 0 })
        row:SetAttribute("Selected", true)
    else
        Tween(row, { BackgroundColor3 = Theme.Element })
        Tween(refs.Name, { TextColor3 = Theme.InactiveText })
        Tween(refs.Status, { TextColor3 = Theme.InactiveText })
        Tween(refs.BadgeText, { TextColor3 = Theme.InactiveText })
        Tween(refs.Icon, { ImageTransparency = 0.2 })
        row:SetAttribute("Selected", false)
    end
end

local function WireMainButtons()
    MainUI.LoadBtn.MouseButton1Click:Connect(function()
        if not ActiveRow then return end

        Tween(MainUI.LoadBtn, { BackgroundColor3 = Theme.Accent }, 0.08)
        task.delay(0.1, function()
            if MainUI.LoadBtn and MainUI.LoadBtn.Parent then
                Tween(MainUI.LoadBtn, { BackgroundColor3 = Theme.Element }, 0.15)
            end
        end)

        local cb = FrameCallbacks[ActiveRow]
        if typeof(cb) == "function" then
            cb(ActiveRow, MainUI.Window)
            return
        end

        local url = FrameUrls[ActiveRow]
        if url and url ~= "" then
            local win = MainUI.Window
            FadeOutAndDestroy(win)
            task.spawn(function()
                local ok, err = pcall(function()
                    loadstring(game:HttpGet(url))()
                end)
                if not ok then
                    warn("[AlwaysWinning Loader] Failed to load:", err)
                end
            end)
        end
    end)

    MainUI.CloseBtn.MouseButton1Click:Connect(function()
        FadeOutAndDestroy(MainUI.Window)
    end)
end

WireMainButtons()

function Melatonin.LoadingEffect(duration, player, frameConfigs, _mainTemplate, _gameFrameTemplate)
    duration = duration or 2
    frameConfigs = frameConfigs or {}

    -- rebuild if needed
    if not MainUI.Window or not MainUI.Window.Parent then
        MainUI = BuildMainWindow()
        WireMainButtons()
    end
    if not LoadUI.Window or not LoadUI.Window.Parent then
        LoadUI = BuildLoadingWindow()
    end

    LoadUI.Window.Visible = true
    LoadUI.Fill.Size = UDim2.new(0, 0, 1, 0)
    LoadUI.Status.Text = "Loading..."

    local tween = TweenService:Create(
        LoadUI.Fill,
        TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = UDim2.new(1, 0, 1, 0) }
    )
    tween:Play()

    task.spawn(function()
        local steps = { "Initializing...", "Fetching games...", "Almost ready..." }
        for _, s in ipairs(steps) do
            task.wait(duration / (#steps + 1))
            if LoadUI.Status and LoadUI.Status.Parent then
                LoadUI.Status.Text = s
            end
        end
    end)

    tween.Completed:Once(function()
        local oldLoad = LoadUI.Window
        FadeOutAndDestroy(oldLoad)
        LoadUI = BuildLoadingWindow()

        MainUI.Window.Visible = true

        for _, child in ipairs(MainUI.List:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end
        FrameUrls = {}
        FrameCallbacks = {}
        ActiveRow = nil

        for i, config in ipairs(frameConfigs) do
            local row, refs = CreateGameRow()
            row.LayoutOrder = i
            row.Parent = MainUI.List

            refs.Name.Text = config.GameName or ("Game " .. i)
            refs.Status.Text = config.Status or "Unknown"
            refs.BadgeText.Text = config.SubTime or "—"
            if config.Image and config.Image ~= "" then
                refs.Icon.Image = config.Image
            end

            if config.Url then
                FrameUrls[row] = config.Url
            end
            if typeof(config.Callback) == "function" then
                FrameCallbacks[row] = config.Callback
            end

            row.MouseButton1Click:Connect(function()
                if ActiveRow and ActiveRow ~= row then
                    local prev = ActiveRow
                    local prevRefs = {
                        Name = prev:FindFirstChild("GameName"),
                        Status = prev:FindFirstChild("UpdateStatus"),
                        BadgeText = prev:FindFirstChild("SubTime") and prev.SubTime:FindFirstChild("Text"),
                        Icon = prev:FindFirstChild("ImageLabel"),
                    }
                    if prevRefs.Name then
                        SetRowSelected(prev, prevRefs, false)
                    end
                end
                SetRowSelected(row, refs, true)
                ActiveRow = row
            end)

            row.MouseEnter:Connect(function()
                if not row:GetAttribute("Selected") then
                    Tween(row, { BackgroundColor3 = Theme.HoveredElement })
                end
            end)
            row.MouseLeave:Connect(function()
                if not row:GetAttribute("Selected") then
                    Tween(row, { BackgroundColor3 = Theme.Element })
                end
            end)
        end
    end)
end

